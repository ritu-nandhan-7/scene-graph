# Scene Graph Explorer - non-secret configuration template (Deployment Phase 2).
# Copy to `.env` for local overrides if desired.  NEVER commit a real `.env`
# (it is gitignored); NEVER put secrets in this file.
#
# Frontend (Vite) reads VITE_* variables at BUILD / dev-server start time.
# Backend (FastAPI) reads its variables at RUN time.
# Defaults below are the local development values - production overrides
# them with deployment-specific values provided via the platform's own
# environment settings (not committed to git).

# --- Frontend ---------------------------------------------------------------
# Local default (also hardcoded as an api.js fallback when unset).
VITE_API_URL=http://127.0.0.1:8000
# Browser-only deployment: public, versioned HTTPS prefix for immutable ONNX,
# metadata, and ONNX Runtime files. This is a build-time value, never a secret.
# Production Blob prefix (public model/runtime data, not a credential). Configure
# this exact value in Vercel for both Preview and Production, then redeploy.
VITE_BROWSER_MODEL_BASE_URL=https://wzbcnqif6ddnztyy.public.blob.vercel-storage.com/scene-graph-v1/

# --- Backend (FastAPI / uvicorn) --------------------------------------------
# Bind address / port.  Local defaults preserve existing behavior;
# production uses HOST=0.0.0.0 and the platform-assigned PORT.
HOST=127.0.0.1
PORT=8000
# Comma-separated allowed browser origins (CORS).
# Local defaults are the Vite dev server; production adds its frontend origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# --- Model cache behavior ---------------------------------------------------
# backend/main.py already `setdefault`s both of these to "1" (offline mode,
# no huggingface.co round-trip at startup).  Listed here for documentation;
# only override explicitly if startup downloads must be allowed.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# --- Deployment hardening (Phase 8 / OCI ARM64) -----------------------------
# Maximum concurrent /analyze requests (1 = one at a time; 429 when busy).
INFERENCE_CONCURRENCY=1
# "1" (set by the production Dockerfile) makes startup FAIL with a list of
# missing model artifacts instead of warning; local development omits it.
#SG_REQUIRE_OFFLINE_ARTIFACTS=1
# Combined OCI production builds leave this unset and use same-origin "/api".
# For the Vercel split deployment, set this in Vercel (not this committed file)
# to https://<your-stable-OCI-API-host>; do not use a raw http:// public IP.
#VITE_API_URL=