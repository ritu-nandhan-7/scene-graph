# Scene Graph Explorer - non-secret configuration template (Deployment Phase 2).
# Copy to `.env` for local overrides if desired.  NEVER commit a real `.env`
# (it is gitignored); NEVER put secrets in this file.
#
# Frontend (Vite) reads VITE_* variables at BUILD / dev-server start time.
# Backend (FastAPI) reads its variables at RUN time.
# Defaults below are the local development values - production overrides
# them with deployment-specific values provided via the platform's own
# environment settings (not committed to git).

# --- Frontend ---------------------------------------------------------------
# Local default (also hardcoded as an api.js fallback when unset).
VITE_API_URL=http://127.0.0.1:8000

# --- Backend (FastAPI / uvicorn) --------------------------------------------
# Bind address / port.  Local defaults preserve existing behavior;
# production uses HOST=0.0.0.0 and the platform-assigned PORT.
HOST=127.0.0.1
PORT=8000
# Comma-separated allowed browser origins (CORS).
# Local defaults are the Vite dev server; production adds its frontend origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Model cache behavior ---------------------------------------------------
# backend/main.py already `setdefault`s both of these to "1" (offline mode,
# no huggingface.co round-trip at startup).  Listed here for documentation;
# only override explicitly if startup downloads must be allowed.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1